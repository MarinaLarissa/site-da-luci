{
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "rules": {
    "react/jsx-no-literals": [
      "warn",
      {
        "noStrings": true,
        "ignoreProps": true,
        "noAttributeStrings": false,
        "allowedStrings": [
          "GP",
          "GT",
          "ST",
          "+",
          "-",
          "×",
          "÷",
          ":",
          "✕",
          "✓",
          "📤",
          "🗑️",
          "✏️",
          "(",
          ")",
          "/",
          "%"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "**/*.test.jsx", "**/*.spec.js", "**/*.spec.jsx"],
      "rules": {
        "react/jsx-no-literals": "off"
      }
    }
  ]
}
