# Environment Variables Example for Frontend
# Copy this file to .env.local for local development

# API Configuration
# For development: Leave empty to use proxy (configured in package.json)
# For production build: Set to your backend API URL
# Example: REACT_APP_API_URL=https://site-da-luci-api.onrender.com/api
REACT_APP_API_URL=

# Note: React only exposes variables that start with REACT_APP_
# Other variables will be ignored

# The NODE_ENV variable is automatically set by Create React App:
# - 'development' when running npm start
# - 'production' when running npm run build
# - 'test' when running npm test
