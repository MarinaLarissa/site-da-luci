# Environment Variables Example for Frontend
# Copy this file to .env.local for local development

# OCR.space API Key (free tier - 25k requests/month)
# Get your key at https://ocr.space/ocrapi
REACT_APP_OCR_SPACE_API_KEY=

# Auth redirect URL for OAuth (Google login)
# Set to your deployment URL (e.g. https://marinalarissa.github.io/site-da-luci)
REACT_APP_AUTH_REDIRECT_URL=

# Supabase (auth only — Row Level Security protects data)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
