# Get the root directory of the repository
ROOT_DIR=$(git rev-parse --show-toplevel)

# Validate translation keys before commit
echo "🔍 Validating translation keys..."
cd "$ROOT_DIR/frontend" && npm run validate-i18n

if [ $? -ne 0 ]; then
  echo "❌ Translation validation failed! Fix missing keys before committing."
  exit 1
fi

echo "✅ Translation validation passed"

# Run lint-staged for frontend
echo "🧹 Running lint-staged..."
cd "$ROOT_DIR/frontend" && npx lint-staged

echo "✅ Pre-commit checks complete"
